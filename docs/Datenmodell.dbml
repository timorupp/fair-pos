// FairPOS — Data Model
// Updated: May 2026
// Database: PostgreSQL
// Visualization: dbdiagram.io (import file or paste content)

Project FairPOS {
  database_type: 'PostgreSQL'
  Note: 'POS system for non-profit associations (KassenSichV / DSFinV-K v2.4)'
}

// ═══════════════════════════════════════════════════════════════════════════════
// USERS & REGISTERS
// ═══════════════════════════════════════════════════════════════════════════════

// A user of the system. Administrators manage the system; non-administrators
// operate registers assigned to them.
Table user {
  id             uuid         [pk, default: `gen_random_uuid()`]
  name           varchar(100) [not null, unique]
  password_hash  varchar(255) [not null]
  is_admin       boolean      [not null, default: false]
  created_at     timestamptz  [not null, default: `now()`]
}

// A cash register. Type determines the UI shown to the operator.
// Bonkasse = self-checkout with receipt printer.
// Bedienungskasse = table-service terminal without printer.
Table register {
  id          uuid         [pk, default: `gen_random_uuid()`]
  name        varchar(100) [not null]
  type        varchar(20)  [not null, note: 'receipt_register | service_register']
  printer_id  uuid         [null, note: 'receipt_register only: assigned receipt printer']
  created_at  timestamptz  [not null, default: `now()`]
}

// Many-to-many: which registers a user has access to.
Table user_register {
  user_id     uuid [not null]
  register_id uuid [not null]

  indexes {
    (user_id, register_id) [pk]
  }
}

// One-time QR code token generated by an administrator so a user can log in
// to their assigned registers. Valid for 10 minutes, single use.
Table register_access_token {
  id          uuid        [pk, default: `gen_random_uuid()`]
  user_id     uuid        [not null]
  token       varchar(64) [not null, unique]
  valid_until timestamptz [not null]
  created_at  timestamptz [not null, default: `now()`]
}

// ═══════════════════════════════════════════════════════════════════════════════
// ARTICLES & CATEGORIES
// ═══════════════════════════════════════════════════════════════════════════════

// Groups articles by type and carries the applicable VAT rate.
Table article_category {
  id         uuid         [pk, default: `gen_random_uuid()`]
  name       varchar(100) [not null]
  tax_rate   decimal(5,2) [not null, note: '0.00 | 7.00 | 19.00']
  created_at timestamptz  [not null, default: `now()`]
}

// A sellable item. Linked to a category (which carries the VAT rate).
// Optionally assigned to a printer for kitchen/bar order slips.
Table article {
  id            uuid          [pk, default: `gen_random_uuid()`]
  category_id   uuid          [not null]
  name          varchar(100)  [not null]
  price         decimal(10,2) [not null]
  deposit_price decimal(10,2) [null, note: 'Positive = deposit charged; negative = deposit refunded']
  printer_id    uuid          [null, note: 'Printer for order slips; null = default printer']
  is_active     boolean       [not null, default: true]
  created_at    timestamptz   [not null, default: `now()`]
}

// A selectable option for an article (e.g. "with ketchup").
// Multiple options per article allowed; multiple selection always permitted.
Table product_option {
  id              uuid          [pk, default: `gen_random_uuid()`]
  article_id      uuid          [not null]
  name            varchar(100)  [not null]
  price_surcharge decimal(10,2) [not null, default: 0]
}

// ═══════════════════════════════════════════════════════════════════════════════
// REGISTER LAYOUT
// ═══════════════════════════════════════════════════════════════════════════════

// A named button layout assigned to a register. One layout per register type
// can be marked as the system-wide default.
Table register_layout {
  id         uuid         [pk, default: `gen_random_uuid()`]
  register_id uuid        [not null]
  name       varchar(100) [not null]
  is_default boolean      [not null, default: false]
  created_at timestamptz  [not null, default: `now()`]
}

// A single article button placed at a grid position within a layout.
Table register_layout_slot {
  id                 uuid      [pk, default: `gen_random_uuid()`]
  register_layout_id uuid      [not null]
  article_id         uuid      [not null]
  grid_row           int       [not null]
  grid_col           int       [not null]
  color              varchar(7)[not null, note: 'Hex color code, e.g. #FF5733']

  indexes {
    (register_layout_id, grid_row, grid_col) [unique]
  }
}

// ═══════════════════════════════════════════════════════════════════════════════
// FLOOR PLAN & TABLES
// ═══════════════════════════════════════════════════════════════════════════════

// A dining table placed on the single floor plan. pos_x / pos_y are grid
// coordinates used to render the floor plan in the UI.
Table dining_table {
  id      uuid        [pk, default: `gen_random_uuid()`]
  name    varchar(50) [not null]
  pos_x   int         [not null]
  pos_y   int         [not null]
  is_active boolean   [not null, default: true]
}

// ═══════════════════════════════════════════════════════════════════════════════
// PRINTERS
// ═══════════════════════════════════════════════════════════════════════════════

// An ESC/POS network printer reachable via TCP/IP.
Table printer {
  id         uuid         [pk, default: `gen_random_uuid()`]
  name       varchar(100) [not null]
  ip_address varchar(45)  [not null]
  port       int          [not null, default: 9100]
  is_default boolean      [not null, default: false]
  created_at timestamptz  [not null, default: `now()`]
}

// ═══════════════════════════════════════════════════════════════════════════════
// DAILY CLOSING (Z-BON)
// ═══════════════════════════════════════════════════════════════════════════════

// A daily closing record (Z-Bon) for one register. z_number must be sequential
// per register with no gaps (GoBD requirement). is_zero_closing = true when no
// transactions occurred and the system auto-generated this record.
Table daily_closing {
  id                    uuid          [pk, default: `gen_random_uuid()`]
  register_id           uuid          [not null]
  z_number              int           [not null, note: 'Sequential per register, no gaps allowed (GoBD)']
  created_at            timestamptz   [not null, default: `now()`]
  created_by            uuid          [null, note: 'User ID; null for automatic zero closings']
  is_zero_closing       boolean       [not null, default: false]
  total_gross           decimal(12,2) [not null]
  total_tax_standard    decimal(12,2) [not null, note: '19% tax portion']
  total_tax_reduced     decimal(12,2) [not null, note: '7% tax portion']
  total_tax_zero        decimal(12,2) [not null, note: '0% (tax-exempt) portion']
  total_cash            decimal(12,2) [not null]
  total_cancellations   decimal(12,2) [not null]
  tse_transaction_number bigint       [null]
  tse_signature         text          [null]
  tse_signature_counter bigint        [null]

  indexes {
    (register_id, z_number) [unique]
  }
}

// ═══════════════════════════════════════════════════════════════════════════════
// ORDER ITEMS & INVOICES
// ═══════════════════════════════════════════════════════════════════════════════

// One record per article unit ordered. Three Bier = three rows.
// All article data is snapshotted at order time so later changes to the
// article catalogue do not affect existing orders.
//
// status:
//   open       — not yet invoiced; sitting on a table
//   paid       — included on an invoice and paid normally
//   free       — 100% discount; original price preserved; 0 € invoice with TSE
//   cancelled  — silently removed; no invoice, no TSE transaction
Table order_item {
  id                   uuid          [pk, default: `gen_random_uuid()`]
  invoice_id           uuid          [null, note: 'Null while open; set when invoiced']
  dining_table_id      uuid          [null, note: 'Null for receipt_register items']
  register_id          uuid          [not null]
  user_id              uuid          [null, note: 'Waiter who took the order']

  // Soft reference to original article — snapshot fields below are authoritative
  article_id           uuid          [null, note: 'Soft reference; null if article archived']

  // Snapshot at order time — immutable after creation
  article_name         varchar(100)  [not null]
  article_category_name varchar(100) [not null]
  tax_rate             decimal(5,2)  [not null]
  price                decimal(10,2) [not null, note: 'Original price — preserved even for free items']
  deposit_price        decimal(10,2) [null]

  // Selected options as comma-separated snapshot; surcharge already included in price
  options              text          [null, note: 'e.g. "with ketchup, without onions"']

  status                  varchar(20) [not null, note: 'open | paid | free | cancelled']
  cancellation_reason_id  uuid        [null, note: 'Set for free and cancelled items']
  cancelled_by            uuid        [null, note: 'User ID of the waiter who cancelled']
  created_at              timestamptz [not null, default: `now()`]
  cancelled_at            timestamptz [null]
}

// A fiscal receipt created at payment time. Carries the TSE signature.
// Links to its order_items via order_item.invoice_id.
// For receipt_register: created atomically together with its order_items.
// For service_register: created when the waiter initiates payment.
Table invoice {
  id                    uuid         [pk, default: `gen_random_uuid()`]
  register_id           uuid         [not null]
  daily_closing_id      uuid         [null, note: 'Set after daily closing']
  receipt_number        bigint       [not null, unique, note: 'System-wide sequential (DSFinV-K: BON_ID)']
  receipt_type          varchar(30)  [not null, note: 'sales_receipt | cancellation | training']
  payment_method        varchar(20)  [not null, note: 'cash | card']
  cancels_invoice_id    uuid         [null, note: 'Reference to cancelled invoice (cancellation type)']
  cancellation_note     text         [null]
  receipt_token         varchar(64)  [null, unique, note: 'Token for QR code URL: /receipt/{token}']
  created_at            timestamptz  [not null, default: `now()`]
  tse_transaction_number bigint      [null]
  tse_start_time        timestamptz  [null]
  tse_end_time          timestamptz  [null]
  tse_signature         text         [null]
  tse_signature_counter bigint       [null]
  tse_serial_number     varchar(128) [null, note: 'Snapshot of TSE serial number at transaction time']
}

// ═══════════════════════════════════════════════════════════════════════════════
// PRINT QUEUE
// ═══════════════════════════════════════════════════════════════════════════════

// A pending print job in the queue. Created atomically with the triggering
// invoice or daily closing. The print worker is notified via PostgreSQL
// LISTEN/NOTIFY and retries failed jobs periodically.
Table print_job {
  id              uuid        [pk, default: `gen_random_uuid()`]
  printer_id      uuid        [not null]
  type            varchar(20) [not null, note: 'order_slip | receipt | daily_closing']
  content         text        [not null, note: 'ESC/POS content (Base64)']
  reference_id    uuid        [null, note: 'ID of the related invoice or daily_closing']
  status          varchar(20) [not null, default: 'pending', note: 'pending | printing | done | failed']
  created_at      timestamptz [not null, default: `now()`]
  attempts        int         [not null, default: 0]
  last_attempt_at timestamptz [null]
  error_message   text        [null]
}

// ═══════════════════════════════════════════════════════════════════════════════
// CONFIGURATION
// ═══════════════════════════════════════════════════════════════════════════════

// A configurable reason for cancelling or giving away items for free.
// booking_type determines whether a 0 € invoice is created (free) or the
// item is silently removed (cancellation).
Table cancellation_reason {
  id           uuid         [pk, default: `gen_random_uuid()`]
  name         varchar(100) [not null]
  booking_type varchar(30)  [not null, note: 'cancellation | free_of_charge']
  is_active    boolean      [not null, default: true]
}

// Generic key-value store for system-wide settings
// (e.g. server_address, register_serial_number).
Table system_setting {
  key        varchar(100) [pk]
  value      text         [not null]
  updated_at timestamptz  [not null, default: `now()`]
}

// TSE configuration: no database table needed.
// - middleware_url          → environment variable TSE_MIDDLEWARE_URL (Docker)
// - serial_number           → read live from middleware API
// - bsi_certification_id    → read from TSE certificate via middleware; fallback: system_setting
// - activation_date         → read live from middleware API

// ═══════════════════════════════════════════════════════════════════════════════
// FOREIGN KEYS
// ═══════════════════════════════════════════════════════════════════════════════

// Users & registers
Ref: register.printer_id > printer.id
Ref: user_register.user_id > user.id
Ref: user_register.register_id > register.id
Ref: register_access_token.user_id > user.id

// Articles
Ref: article.category_id > article_category.id
Ref: article.printer_id > printer.id
Ref: product_option.article_id > article.id

// Register layout
Ref: register_layout.register_id > register.id
Ref: register_layout_slot.register_layout_id > register_layout.id
Ref: register_layout_slot.article_id > article.id

// Daily closing
Ref: daily_closing.register_id > register.id
Ref: daily_closing.created_by > user.id

// Order items & invoices
Ref: order_item.invoice_id > invoice.id
Ref: order_item.dining_table_id > dining_table.id
Ref: order_item.register_id > register.id
Ref: order_item.user_id > user.id
Ref: order_item.article_id > article.id
Ref: order_item.cancellation_reason_id > cancellation_reason.id
Ref: order_item.cancelled_by > user.id
Ref: invoice.register_id > register.id
Ref: invoice.daily_closing_id > daily_closing.id
Ref: invoice.cancels_invoice_id > invoice.id

// Print queue
Ref: print_job.printer_id > printer.id
