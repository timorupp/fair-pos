# Copy this file to .env and fill in the values.

# PostgreSQL
POSTGRES_USER=fairpos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fairpos
DATABASE_URL=postgresql://fairpos:changeme@postgres:5432/fairpos

# Backend
NODE_ENV=development
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Swissbit USB-TSE (see docs/TSE-Integration.md). Both optional — omit them in
# dev/CI environments without a physical TSE attached; the checkout endpoints
# then simply skip signing and leave the invoice's tse_* columns null.
# Can also be left unset here and configured later via Systemeinstellungen ->
# System in the admin UI, which takes effect immediately without a restart.
TSE_MOUNT_POINT=/mnt/tse-usb
TSE_CLIENT_ID=FairPOS-1
