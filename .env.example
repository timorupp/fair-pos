# Copy this file to .env and fill in the values.

# PostgreSQL
POSTGRES_USER=fairpos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fairpos
DATABASE_URL=postgresql://fairpos:changeme@postgres:5432/fairpos

# Backend
NODE_ENV=development
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# TSE middleware (fiskaltrust)
TSE_MIDDLEWARE_URL=http://fiskaltrust:1500
