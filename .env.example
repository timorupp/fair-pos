# Copy this file to .env and fill in the values.
#
# In development, `docker compose up -d` starts only PostgreSQL from this
# file (POSTGRES_* below); the backend/frontend run locally via `npm run dev`
# and read DATABASE_URL etc. directly from the environment (no Docker
# involved for the app itself, in dev or in production — see
# docs/SETUP.md → "Production-Deployment").

# PostgreSQL — POSTGRES_* configure the dev-only Docker container
# (docker-compose.yml); DATABASE_URL is what the backend actually connects
# with. In dev that's "postgres" is not a valid host without the container's
# own network — use localhost against the port mapped in docker-compose.yml.
# In a native production install (no Docker), point DATABASE_URL at wherever
# `apt`-installed PostgreSQL actually listens (usually localhost:5432 too).
POSTGRES_USER=fairpos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fairpos
DATABASE_URL=postgresql://fairpos:changeme@localhost:5432/fairpos

# Backend
NODE_ENV=development
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Swissbit USB-TSE (see docs/TSE-Integration.md). Both optional — omit them in
# dev/CI environments without a physical TSE attached; the checkout endpoints
# then simply skip signing and leave the invoice's tse_* columns null.
# TSE_MOUNT_POINT only matters as an initial seed value (e.g. for a systemd
# EnvironmentFile) — it can always be set/changed later via Systemeinstellungen
# -> System in the admin UI (including via the "Auto-erkennen" button), which
# takes effect immediately without a restart.
TSE_MOUNT_POINT=/mnt/tse-usb
TSE_CLIENT_ID=FairPOS-1
