{
  "name": "@fairpos/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx/esm --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "node --env-file=../../.env --import tsx/esm src/db/migrate.ts",
    "db:seed": "node --env-file=../../.env --import tsx/esm src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fairpos/shared": "*",
    "@fastify/cookie": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.0.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.28.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "testcontainers": "^10.28.0",
    "tsx": "^4.19.0",
    "typescript": "*",
    "vitest": "^4.1.9"
  }
}
